<footer class="site-footer gutter">
    <span class="wordmark wordmark-sm">{{@site.title}}</span>
    {{navigation type="secondary"}}
    <span class="footer-note">
        &copy; {{date format="YYYY"}} {{@site.title}}. For the long way round.
        <a class="footer-cookie-link" href="https://www.google.com/preferences/source?q=throttle-times.com" rel="noopener" target="_blank">Google News</a>
        <a class="footer-cookie-link" href="https://x.com/Throttle_Times" rel="me noopener" target="_blank">X</a>
        <a class="footer-cookie-link" href="https://bsky.app/profile/throttle-times.com" rel="me noopener" target="_blank">Bluesky</a>
        <a class="footer-cookie-link" href="https://t.me/hthrottle_times" rel="me noopener" target="_blank">Telegram</a>
        <a class="footer-cookie-link" href="https://www.facebook.com/throttleetimes/" rel="me noopener" target="_blank">Facebook</a>
        <a class="footer-cookie-link" href="https://mastodon.social/@hrottle_times" rel="me noopener" target="_blank">Mastodon</a>
        {{!-- routes.yaml puts the collection at /articles/, so the feed is
              /articles/rss/ — not Ghost's default /rss/. --}}
        <a class="footer-cookie-link" href="{{@site.url}}/articles/rss/">RSS</a>
        {{#if @custom.google_analytics_id}}
            <a class="footer-cookie-link" href="#" data-cookie-settings>Cookie settings</a>
        {{/if}}
    </span>
</footer>
