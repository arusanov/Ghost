{{!-- Shared image slot. Falls back to the hatched "PHOTO —" placeholder from the
design when a post has no feature image, so imageless posts still look deliberate.
Params: lazy (boolean) --}}
{{#if feature_image}}
    <img class="media-img"
        src="{{img_url feature_image size="l"}}"
        srcset="{{img_url feature_image size="s"}} 320w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 960w,
                {{img_url feature_image size="xl"}} 1200w"
        sizes="(max-width: 700px) 100vw, 33vw"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        {{#if lazy}}loading="lazy" decoding="async"{{else}}fetchpriority="high" decoding="async"{{/if}}>
{{else}}
    <span class="media-placeholder" aria-hidden="true">
        <span class="media-label">PHOTO — {{#if primary_tag}}{{primary_tag.name}}{{else}}{{@site.title}}{{/if}}</span>
    </span>
{{/if}}
