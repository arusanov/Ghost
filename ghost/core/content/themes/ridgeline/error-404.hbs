                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Search articles</span>
        </button>
        <a class="read-more" href="/articles/">All Articles &rarr;</a>
    </div>
</main>
