{{!< default}}

<main class="error-page gutter">
    <span class="error-code">404</span>
    <h1 class="post-title">Wrong turn.</h1>
    <p class="hero-excerpt">This road isn't on any map we have. Search the archive or head back to the main track.</p>
    <div class="error-actions">
        <button class="error-search-btn" type="button" data-ghost-search aria-label="Search articles">
