<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{!-- Display + body typefaces, self-hosted. These used to load from
          fonts.googleapis.com, which put a render-blocking cross-origin
          stylesheet plus two extra origins on the critical path of every page.
          Preload only the two faces that are always above the fold: Archivo 900
          (the headline) and Inter 400 (body copy). --}}
    <link rel="preload" href="{{asset "fonts/archivo-900-latin.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{asset "fonts/inter-400-latin.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" type="text/css" href="{{asset "css/fonts.css"}}">

    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}">

    {{!-- gtag.js is fetched async from a third origin; warm the connection now
          rather than paying DNS + TLS at request time. --}}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>

    {{!-- Analytics + Consent Mode default (must run before any tracking) --}}
    {{> "analytics"}}

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other
    important settings, it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

</head>
<body class="{{body_class}}">

<div class="site">

    {{> "site-header"}}

    {{{body}}}

    {{> "site-footer"}}

</div>

{{> "cookie-consent"}}

<script defer src="{{asset "js/main.js"}}"></script>

{{!-- Ghost outputs required functional scripts with this tag, it should always
be the last thing before the closing body tag --}}
{{ghost_foot}}

</body>
</html>
