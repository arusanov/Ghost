<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below.
          Custom collection routes (/articles/) get a generic "Site Title (Page 1)"
          from Ghost with no meta description, so override both there. --}}
    <title>{{#is "home, post, page, tag, author"}}{{meta_title}}{{else}}All Articles{{#is "paged"}} (Page {{pagination.page}}){{/is}} - {{@site.title}}{{/is}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{^is "home, post, page, tag, author, paged"}}
    <meta name="description" content="All motorcycle news, adventure bike buyer's guides, gear reviews, spy shots, and patent filings published on {{@site.title}}.">
    {{/is}}

    {{!-- Display + body typefaces, self-hosted. These used to load from
          fonts.googleapis.com, which put a render-blocking cross-origin
          stylesheet plus two extra origins on the critical path of every page.
          Preload only the two faces that are always above the fold: Archivo 900
          (the headline) and Inter 400 (body copy). --}}
    <link rel="preload" href="{{asset "fonts/archivo-900-latin.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{asset "fonts/inter-400-latin.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" type="text/css" href="{{asset "css/fonts.css"}}">

    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}">

    {{!-- gtag.js is fetched async from a third origin; warm the connection now
          rather than paying DNS + TLS at request time. --}}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>

    {{!-- Analytics + Consent Mode default (must run before any tracking) --}}
    {{> "analytics"}}

    {{!-- Keep paginated archive pages (/articles/page/2/, /tag/*/page/2/) and
          0-post tag pages out of the index while following their links.
          Tags with >=1 post are included in Ghost's auto-generated
          sitemap-tags.xml, so marking them noindex causes "Submitted URL
          marked 'noindex'" errors in Search Console. --}}
    {{#is "paged"}}
    <meta name="robots" content="noindex, follow">
    {{else}}
    {{#is "tag"}}{{#match pagination.total "<" 1}}<meta name="robots" content="noindex, follow">{{else}}<meta name="robots" content="index, follow, max-image-preview:large">{{/match}}{{else}}<meta name="robots" content="index, follow, max-image-preview:large">{{/is}}
    {{/is}}

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other
    important settings, it should always be the last tag before the closing head tag --}}
    <link rel="me" href="https://mastodon.social/@hrottle_times">
    <link rel="me" href="https://x.com/Throttle_Times">
    <link rel="me" href="https://bsky.app/profile/throttle-times.com">
    <link rel="me" href="https://www.facebook.com/throttleetimes/">
    <link rel="hub" href="https://pubsubhubbub.appspot.com/">
    {{!-- Google Preferred Sources / Publisher SDK --}}
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    {{#is "home"}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "NewsMediaOrganization",
        "name": "{{@site.title}}",
        "url": "{{@site.url}}",
        "logo": {
            "@type": "ImageObject",
            "url": "{{@site.url}}/content/images/throttle-favicon.png",
            "width": 512,
            "height": 512
        },
        "foundingDate": "2026",
        "publishingPrinciples": "{{@site.url}}/about/",
        "sameAs": [
            "https://x.com/Throttle_Times",
            "https://bsky.app/profile/throttle-times.com",
            "https://t.me/hthrottle_times",
            "https://www.facebook.com/throttleetimes/",
            "https://mastodon.social/@hrottle_times"
        ]
    }
    </script>
    {{/is}}
    {{ghost_head}}

</head>
<body class="{{body_class}}">

<div class="site">

    {{> "site-header"}}

    {{{body}}}

    {{> "site-footer"}}

</div>

{{> "cookie-consent"}}

<script defer src="{{asset "js/main.js"}}"></script>
{{#if @custom.google_analytics_id}}
<script defer src="{{asset "js/funnel.js"}}"></script>
{{/if}}

{{!-- Ghost outputs required functional scripts with this tag, it should always
be the last thing before the closing body tag --}}
{{ghost_foot}}

</body>
</html>
