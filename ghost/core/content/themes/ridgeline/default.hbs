<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{!-- Display + body typefaces, matching the Ridgeline design --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}">

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other
    important settings, it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

</head>
<body class="{{body_class}}">

<div class="site">

    {{> "site-header"}}

    {{{body}}}

    {{> "site-footer"}}

</div>

<script src="{{asset "js/main.js"}}"></script>

{{!-- Ghost outputs required functional scripts with this tag, it should always
be the last thing before the closing body tag --}}
{{ghost_foot}}

</body>
</html>
