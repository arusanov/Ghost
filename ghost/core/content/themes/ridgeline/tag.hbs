{{!< default}}
{{!-- Category archive. Same shape as /articles/ so the tabs read as a filter. --}}

<main class="archive">

    {{#tag}}
        <header class="archive-head gutter">
            <h1 class="archive-title">{{name}}</h1>
            {{#if description}}<p class="archive-description">{{description}}</p>{{/if}}
            {{> "category-tabs" activeSlug=slug}}
        </header>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "{{@site.url}}"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "{{name}}",
                    "item": "{{url absolute="true"}}"
                }
            ]
        }
        </script>
    {{/tag}}

    <section class="section gutter">
        <div class="grid grid-3">
            {{#foreach posts}}
                {{> "post-card" showExcerpt=true}}
            {{/foreach}}
        </div>
        {{> "pagination"}}
    </section>

</main>
