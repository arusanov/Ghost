{{!< default}}

{{#post}}
<div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>
<main class="post" data-post-slug="{{slug}}">

    <header class="post-header">
        <div class="kicker">
            {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            <span class="dot"></span>
            <span class="meta">
                <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM D, YYYY"}}</time>
                {{!-- Only show an "updated" stamp when the post genuinely changed on
                      a later day — comparing formatted dates, since every save nudges
                      updated_at by a few seconds and that isn't worth surfacing. --}}
                {{#match (date published_at format="YYYY-MM-DD") "!=" (date updated_at format="YYYY-MM-DD")}}
                    &middot; Updated <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="MMMM D, YYYY"}}</time>
                {{/match}}
                &middot; {{reading_time}}
            </span>
        </div>

        <h1 class="post-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        <div class="post-byline-bar">
            <div class="byline">
                {{#foreach authors}}
                    <a class="byline-author" rel="author" href="{{url}}">
                        {{#if profile_image}}
                            <img class="byline-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}">
                        {{else}}
                            <span class="byline-avatar">{{> "icons/avatar"}}</span>
                        {{/if}}
                        <span>
                            <span class="byline-name">{{name}}</span>
                            {{#if bio}}<span class="byline-role">{{bio}}</span>{{/if}}
                        </span>
                    </a>
                {{/foreach}}
            </div>

            <div class="post-header-actions">
                {{#has tag="#hub, Event Hubs"}}
                <button class="jump-to-updates-btn" id="jump-to-updates-btn" type="button" hidden title="Jump to the newest live update">
                    <span class="live-pulse-dot" aria-hidden="true"></span>
                    <span class="jump-text">Jump to New Updates</span>
                    <span class="jump-badge-count" id="jump-badge-count" hidden>0</span>
                </button>
                {{/has}}

                <div class="google-preferred-badge">
                    <a class="google-news-btn" id="google-preferred-btn" href="https://www.google.com/preferences/source?q=throttle-times.com" target="_blank" rel="noopener" title="Add Throttle Times as a preferred source on Google Search and Discover">
                        <svg class="google-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.88c2.27-2.09 3.665-5.17 3.665-9.14z"/>
                            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.04c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.13C3.27 21.39 7.34 24 12 24z"/>
                            <path fill="#FBBC05" d="M5.28 14.28c-.25-.72-.38-1.49-.38-2.28s.13-1.56.38-2.28V6.59H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.41l4.03-3.13z"/>
                            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.27 2.61 1.25 6.59l4.03 3.13c.95-2.83 3.6-4.97 6.72-4.97z"/>
                        </svg>
                        <span class="google-news-label">Preferred on Google</span>
                        <span class="google-news-cta">+ Follow</span>
                    </a>
                </div>

                <button class="share-story-btn" id="share-story-btn" type="button" title="Share this article" aria-label="Share this article">
                    <svg class="share-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                    <span class="share-btn-text">Share</span>
                </button>
            </div>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-feature">
            {{!-- This is the LCP element on every article: never lazy, and hinted
                  high-priority so it starts downloading before the stylesheet
                  finishes. No width/height: Ghost doesn't expose the feature
                  image's real dimensions to themes, and the script accepts
                  anything from 1.65 to 4.2, so any hardcoded pair would be wrong
                  for most posts — worse than omitting them. --}}
            <img src="{{img_url feature_image size="xxl"}}"
                srcset="{{img_url feature_image size="l"}} 960w,
                        {{img_url feature_image size="xl"}} 1200w,
                        {{img_url feature_image size="xxl"}} 2000w"
                sizes="(max-width: 1040px) 100vw, 1040px"
                fetchpriority="high" decoding="async"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <article {{#if access}}data-analytics-post="{{id}}"{{/if}} class="article-body {{post_class}}{{#if @custom.enable_drop_caps}} has-drop-cap{{/if}}">
        {{content}}
    </article>

    {{#if tags}}
        <div class="post-tags">
            {{#foreach tags}}
                <a class="chip" href="{{url}}">{{name}}</a>
            {{/foreach}}
        </div>
    {{/if}}

    <aside class="post-social-bar" aria-label="Share and follow">
        <div class="post-social-row">
            <span class="post-social-label">Share story</span>
            <div class="post-social-links">
                <a class="chip" href="https://www.facebook.com/sharer/sharer.php?u={{encode (url absolute="true")}}" target="_blank" rel="noopener">Facebook</a>
                <a class="chip" href="https://x.com/intent/tweet?url={{encode (url absolute="true")}}&text={{encode title}}&via=Throttle_Times" target="_blank" rel="noopener">X</a>
                <a class="chip" href="https://bsky.app/intent/compose?text={{encode title}}%20{{encode (url absolute="true")}}" target="_blank" rel="noopener">Bluesky</a>
                <a class="chip" href="https://t.me/share/url?url={{encode (url absolute="true")}}&text={{encode title}}" target="_blank" rel="noopener">Telegram</a>
            </div>
        </div>
        <div class="post-social-row">
            <span class="post-social-label">Follow us</span>
            <div class="post-social-links">
                <a class="post-social-link" href="https://www.google.com/preferences/source?q=throttle-times.com" target="_blank" rel="noopener">Google News</a>
                <a class="post-social-link" href="https://t.me/hthrottle_times" target="_blank" rel="me noopener">Telegram</a>
                <a class="post-social-link" href="https://bsky.app/profile/throttle-times.com" target="_blank" rel="me noopener">Bluesky</a>
                <a class="post-social-link" href="https://x.com/Throttle_Times" target="_blank" rel="me noopener">X</a>
                <a class="post-social-link" href="https://www.facebook.com/throttleetimes/" target="_blank" rel="me noopener">Facebook</a>
                <a class="post-social-link" href="https://mastodon.social/@hrottle_times" target="_blank" rel="me noopener">Mastodon</a>
                <a class="post-social-link" href="{{@site.url}}/articles/rss/">RSS</a>
            </div>
        </div>
    </aside>

    {{#if comments}}
        <section class="post-comments">
            {{comments}}
        </section>
    {{/if}}

    {{#has tag="#hub, Event Hubs"}}
    <button class="floating-jump-updates" id="floating-jump-updates" type="button" aria-label="Jump to newest update" hidden>
        <span class="live-pulse-dot" aria-hidden="true"></span>
        <span class="floating-jump-label">New Updates</span>
        <span class="floating-jump-arrow" aria-hidden="true">↓</span>
    </button>
    {{/has}}

    <button class="back-to-top-btn" id="back-to-top-btn" type="button" hidden title="Back to top" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

</main>
{{#if primary_tag}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{@site.url}}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{primary_tag.name}}",
            "item": "{{primary_tag.url}}"
        }{{#if tags.[1]}},
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{tags.[1].name}}",
            "item": "{{tags.[1].url}}"
        }{{/if}}
    ]
}
</script>
{{/if}}

{{#has tag="#hub, Event Hubs"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LiveBlogPosting",
    "headline": "{{title}}",
    "description": "{{custom_excerpt}}",
    "coverageStartTime": "{{date published_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "datePublished": "{{date published_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "dateModified": "{{date updated_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "url": "{{url absolute="true"}}",
    "publisher": {
        "@type": "NewsMediaOrganization",
        "name": "{{@site.title}}",
        "url": "{{@site.url}}"
    }
}
</script>
{{/has}}
{{/post}}

{{!-- Related posts: prefer the second tag (brand/segment, e.g. KTM, Helmets)
      so articles cluster by topic instead of all matching primary_tag ("News"). --}}
{{#if post.tags.[1]}}
    {{#get "posts" filter="tag:{{post.tags.[1].slug}}+id:-{{post.id}}" limit="3" include="tags" as |related|}}
        {{#if related}}
            <section class="section related gutter">
                <h2 class="section-title">More From {{../post.tags.[1].name}}</h2>
                <div class="grid grid-3">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </section>
        {{else}}
            {{#if ../post.primary_tag}}
                {{#get "posts" filter="tag:{{../post.primary_tag.slug}}+id:-{{../post.id}}" limit="3" include="tags" as |fallback|}}
                    {{#if fallback}}
                        <section class="section related gutter">
                            <h2 class="section-title">More From {{../../post.primary_tag.name}}</h2>
                            <div class="grid grid-3">
                                {{#foreach fallback}}
                                    {{> "post-card"}}
                                {{/foreach}}
                            </div>
                        </section>
                    {{/if}}
                {{/get}}
            {{/if}}
        {{/if}}
    {{/get}}
{{else if post.primary_tag}}
    {{#get "posts" filter="tag:{{post.primary_tag.slug}}+id:-{{post.id}}" limit="3" include="tags" as |related|}}
        {{#if related}}
            <section class="section related gutter">
                {{!-- ../ hops out of {{#get}}, whose context is the query result --}}
                <h2 class="section-title">More From {{../post.primary_tag.name}}</h2>
                <div class="grid grid-3">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{else}}
    {{#get "posts" filter="id:-{{post.id}}" limit="3" include="tags" as |related|}}
        {{#if related}}
            <section class="section related gutter">
                <h2 class="section-title">Read Next</h2>
                <div class="grid grid-3">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}

{{> "newsletter"}}
