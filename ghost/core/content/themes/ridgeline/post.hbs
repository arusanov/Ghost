{{!< default}}

{{#post}}
<main class="post">

    {{> "breadcrumbs" trail_title=title}}

    <header class="post-header">
        <div class="kicker">
            {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            <span class="dot"></span>
            <span class="meta">
                <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM D, YYYY"}}</time>
                {{!-- Only show an "updated" stamp when the post genuinely changed on
                      a later day — comparing formatted dates, since every save nudges
                      updated_at by a few seconds and that isn't worth surfacing. --}}
                {{#match (date published_at format="YYYY-MM-DD") "!=" (date updated_at format="YYYY-MM-DD")}}
                    &middot; Updated <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="MMMM D, YYYY"}}</time>
                {{/match}}
                &middot; {{reading_time}}
            </span>
        </div>

        <h1 class="post-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        <div class="byline">
            {{#foreach authors}}
                <a class="byline-author" rel="author" href="{{url}}">
                    {{#if profile_image}}
                        <img class="byline-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}">
                    {{else}}
                        <span class="byline-avatar">{{> "icons/avatar"}}</span>
                    {{/if}}
                    <span>
                        <span class="byline-name">{{name}}</span>
                        {{#if bio}}<span class="byline-role">{{bio}}</span>{{/if}}
                    </span>
                </a>
            {{/foreach}}
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-feature">
            {{!-- This is the LCP element on every article: never lazy, and hinted
                  high-priority so it starts downloading before the stylesheet
                  finishes. No width/height: Ghost doesn't expose the feature
                  image's real dimensions to themes, and the script accepts
                  anything from 1.65 to 4.2, so any hardcoded pair would be wrong
                  for most posts — worse than omitting them. --}}
            <img src="{{img_url feature_image size="xxl"}}"
                srcset="{{img_url feature_image size="l"}} 960w,
                        {{img_url feature_image size="xl"}} 1200w,
                        {{img_url feature_image size="xxl"}} 2000w"
                sizes="(max-width: 1040px) 100vw, 1040px"
                fetchpriority="high" decoding="async"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <article class="article-body {{post_class}}{{#if @custom.enable_drop_caps}} has-drop-cap{{/if}}">
        {{content}}
    </article>

    {{#if tags}}
        <div class="post-tags">
            {{#foreach tags}}
                <a class="chip" href="{{url}}">{{name}}</a>
            {{/foreach}}
        </div>
    {{/if}}

    {{#if comments}}
        <section class="post-comments">
            {{comments}}
        </section>
    {{/if}}

</main>
{{/post}}

{{!-- Related posts: same primary tag where possible, otherwise just the newest others --}}
{{#if post.primary_tag}}
    {{#get "posts" filter="tag:{{post.primary_tag.slug}}+id:-{{post.id}}" limit="3" include="tags" as |related|}}
        {{#if related}}
            <section class="section related gutter">
                {{!-- ../ hops out of {{#get}}, whose context is the query result --}}
                <h2 class="section-title">More From {{../post.primary_tag.name}}</h2>
                <div class="grid grid-3">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{else}}
    {{#get "posts" filter="id:-{{post.id}}" limit="3" include="tags" as |related|}}
        {{#if related}}
            <section class="section related gutter">
                <h2 class="section-title">Read Next</h2>
                <div class="grid grid-3">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
