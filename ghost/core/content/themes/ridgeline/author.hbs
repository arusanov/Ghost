{{!< default}}

<main class="archive">

    {{#author}}
        <header class="archive-head gutter">
            <div class="author-head">
                {{#if profile_image}}
                    <img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}">
                {{else}}
                    <span class="author-avatar">{{> "icons/avatar"}}</span>
                {{/if}}
                <div>
                    <h1 class="archive-title">{{name}}</h1>
                    {{#if bio}}<p class="archive-description">{{bio}}</p>{{/if}}
                </div>
            </div>
        </header>
    {{/author}}

    <section class="section gutter">
        <div class="grid grid-3">
            {{#foreach posts}}
                {{> "post-card" showExcerpt=true}}
            {{/foreach}}
        </div>
        {{> "pagination"}}
    </section>

</main>
