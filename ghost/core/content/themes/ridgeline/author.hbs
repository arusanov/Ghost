{{!< default}}

<main class="archive">

    {{#author}}
        <header class="archive-head gutter">
            <div class="author-head">
                {{#if profile_image}}
                    <img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}">
                {{else}}
                    <span class="author-avatar">{{> "icons/avatar"}}</span>
                {{/if}}
                <div>
                    <h1 class="archive-title">{{name}}</h1>
                    {{#if bio}}<p class="archive-description">{{bio}}</p>{{/if}}
                </div>
            </div>
        </header>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "ProfilePage",
            "mainEntity": {
                "@type": "Person",
                "name": "{{name}}",
                "url": "{{url absolute="true"}}",
                {{#if profile_image}}"image": "{{img_url profile_image absolute="true"}}",{{/if}}
                {{#if bio}}"description": "{{bio}}",{{/if}}
                "worksFor": {
                    "@type": "NewsMediaOrganization",
                    "name": "{{@site.title}}",
                    "url": "{{@site.url}}"
                },
                "sameAs": [
                    "https://x.com/Throttle_Times",
                    "https://bsky.app/profile/throttle-times.com",
                    "https://www.facebook.com/throttleetimes/",
                    "https://mastodon.social/@hrottle_times",
                    "{{@site.url}}/about/"
                ]
            }
        }
        </script>
    {{/author}}

    <section class="section gutter">
        <div class="grid grid-3">
            {{#foreach posts}}
                {{> "post-card" showExcerpt=true}}
            {{/foreach}}
        </div>
        {{> "pagination"}}
    </section>

</main>
